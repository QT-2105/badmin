NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BADMIN_LEGACY_CLUB_ID=
BADMIN_ALLOW_LEGACY_TENANT_FALLBACK=false
BADMIN_LOGIN_CLUB_ALLOWLIST=
# When set on UAT, Prisma uses DATABASE_URL_UNPOOLED because Neon poolers reject
# the PostgreSQL startup `role` option. Production should use a dedicated LOGIN.
BADMIN_RUNTIME_DB_ROLE=badmin_uat_app
