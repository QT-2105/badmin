NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

# Optional. Set this on the server when deploying a prebuilt registry image.
# Example: ghcr.io/OWNER/REPO:latest
BADMIN_IMAGE=badmin:latest

# Neon/Postgres pooled connection URL for app runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Neon/Postgres direct/unpooled connection URL for Prisma directUrl.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BADMIN_LEGACY_CLUB_ID=
BADMIN_ALLOW_LEGACY_TENANT_FALLBACK=false
BADMIN_LOGIN_CLUB_ALLOWLIST=
# UAT effective role. Production should use a dedicated least-privilege LOGIN
# in DATABASE_URL so the pooled endpoint remains available.
BADMIN_RUNTIME_DB_ROLE=badmin_uat_app

NEXT_TELEMETRY_DISABLED=1
