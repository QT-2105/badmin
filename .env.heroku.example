# Public application URL. This value is also configured as the GitHub
# production environment variable NEXT_PUBLIC_APP_URL for the Docker build.
NEXT_PUBLIC_APP_URL=https://app.example.com

# Copy these two values from Neon > Connect.
# DATABASE_URL uses the pooled hostname; DATABASE_URL_UNPOOLED uses the direct hostname.
DATABASE_URL=postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DB?sslmode=require

NEXT_TELEMETRY_DISABLED=1

# Required only when image/logo upload is enabled.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
