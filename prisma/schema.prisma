generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model play_dates {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  play_date     DateTime        @unique @db.Date
  title         String?         @db.VarChar(255)
  note          String?
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @db.Timestamp(6)
  play_sessions play_sessions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model play_sessions {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  play_date_id             String                 @db.Uuid
  name                     String                 @db.VarChar(255)
  start_time               DateTime               @db.Time(6)
  end_time                 DateTime               @db.Time(6)
  court_count              Int                    @default(1)
  note                     String?
  status                   String                 @default("NOT_STARTED") @db.VarChar(20)
  court_cost               Decimal?               @default(0) @db.Decimal(12, 2)
  shuttlecock_pieces_used  Int                    @default(0)
  shuttlecock_product_id   String?                @db.Uuid
  shuttlecock_product_name String?                @db.VarChar(255)
  total_income             Decimal?               @default(0) @db.Decimal(12, 2)
  total_expense            Decimal?               @default(0) @db.Decimal(12, 2)
  total_profit             Decimal?               @default(0) @db.Decimal(12, 2)
  created_at               DateTime?              @default(now()) @db.Timestamp(6)
  updated_at               DateTime?              @default(now()) @db.Timestamp(6)
  play_dates               play_dates             @relation(fields: [play_date_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runtime_courts           runtime_courts[]
  runtime_matches          runtime_matches[]
  match_histories          match_histories[]
  session_players          session_players[]
  session_summaries        session_summaries[]
  session_transactions     session_transactions[]

  @@index([play_date_id], map: "idx_play_sessions_play_date_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model runtime_courts {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String           @db.Uuid
  court_number     Int
  status           String           @db.VarChar(20)
  runtime_match_id String?          @db.Uuid
  started_at       DateTime?        @db.Timestamp(6)
  updated_at       DateTime?        @default(now()) @db.Timestamp(6)
  runtime_matches  runtime_matches? @relation(fields: [runtime_match_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  play_sessions    play_sessions    @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_runtime_courts_session_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model runtime_matches {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id     String           @db.Uuid
  queue_order    Int?
  court_number   Int?
  status         String           @db.VarChar(20)
  fairness_score Int?
  team_a         Json
  team_b         Json
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  runtime_courts runtime_courts[]
  play_sessions  play_sessions    @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_runtime_matches_session_id")
}

model session_players {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String        @db.Uuid
  full_name         String        @db.VarChar(255)
  gender            String?       @db.VarChar(10)
  level             Int           @default(1)
  total_matches     Int           @default(0)
  payment_amount    Decimal       @default(0) @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(5, 2)
  payment_method    String?       @db.VarChar(10)
  payment_status    String        @default("UNPAID") @db.VarChar(20)
  runtime_status    String?       @default("WAITING") @db.VarChar(20)
  last_court_number Int?
  note              String?
  player_tags       String[]      @default(["NOT_ARRIVED"])
  avatar_s3_key     String?       @db.VarChar(500)
  avatar_url        String?       @db.VarChar(1000)
  avatar_updated_at DateTime?     @db.Timestamp(6)
  joined_at         DateTime?     @default(now()) @db.Timestamp(6)
  match_history_players match_history_players[]
  play_sessions     play_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session_player_images session_player_images[]

  @@index([session_id], map: "idx_session_players_session_id")
}

model app_settings {
  id          String    @id @default("default") @db.VarChar(50)
  club_name   String    @default("Badmin") @db.VarChar(255)
  logo_s3_key String?   @db.VarChar(500)
  logo_url    String?   @db.VarChar(1000)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model session_player_images {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_player_id String          @db.Uuid
  s3_key            String          @db.VarChar(500)
  public_url        String          @db.VarChar(1000)
  file_name         String?         @db.VarChar(255)
  content_type      String?         @db.VarChar(100)
  file_size         Int?
  status            String          @default("ACTIVE") @db.VarChar(20)
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  updated_at        DateTime?       @default(now()) @db.Timestamp(6)
  session_players   session_players @relation(fields: [session_player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_player_id], map: "idx_session_player_images_player")
  @@index([status], map: "idx_session_player_images_status")
}

model match_histories {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id            String                  @db.Uuid
  court_number          Int
  court_name            String                  @db.VarChar(50)
  started_at            DateTime?               @db.Timestamp(6)
  ended_at              DateTime                @default(now()) @db.Timestamp(6)
  duration_seconds      Int?
  team_a                Json
  team_b                Json
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  play_sessions         play_sessions           @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_history_players match_history_players[]

  @@index([session_id, ended_at], map: "idx_match_histories_session_ended")
  @@index([session_id, court_number], map: "idx_match_histories_session_court")
}

model match_history_players {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  match_history_id  String          @db.Uuid
  session_player_id String          @db.Uuid
  team              String          @db.VarChar(10)
  position          Int
  match_histories   match_histories @relation(fields: [match_history_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session_players   session_players @relation(fields: [session_player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([match_history_id, session_player_id], map: "uq_match_history_player")
  @@index([session_player_id], map: "idx_match_history_players_player")
}

model session_summaries {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String        @db.Uuid
  total_players Int           @default(0)
  total_income  Decimal?      @default(0) @db.Decimal(12, 2)
  total_expense Decimal?      @default(0) @db.Decimal(12, 2)
  total_profit  Decimal?      @default(0) @db.Decimal(12, 2)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  play_sessions play_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model session_transactions {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String?        @db.Uuid
  transaction_type String         @db.VarChar(20)
  category         String         @db.VarChar(30)
  title            String?        @db.VarChar(255)
  quantity         Decimal?       @default(1) @db.Decimal(12, 2)
  unit_price       Decimal?       @default(0) @db.Decimal(12, 2)
  total_amount     Decimal        @default(0) @db.Decimal(12, 2)
  note             String?
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  play_sessions    play_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model shuttlecock_inventory {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shuttlecock_product_id   String               @unique @db.Uuid
  quantity_ball            Int                  @default(0)
  avg_cost_per_ball        Decimal?             @default(0) @db.Decimal(18, 6)
  avg_usage_price_per_ball Decimal?             @default(0) @db.Decimal(18, 6)
  updated_at               DateTime?            @default(now()) @db.Timestamp(6)
  shuttlecock_products     shuttlecock_products @relation(fields: [shuttlecock_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model shuttlecock_movements {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shuttlecock_product_id String               @db.Uuid
  movement_type          String               @db.VarChar(20)
  quantity_ball          Int                  @default(0)
  cost_per_ball          Decimal?             @db.Decimal(18, 6)
  usage_price_per_ball   Decimal?             @db.Decimal(18, 6)
  unit_price             Decimal?             @db.Decimal(18, 6)
  title                  String?              @db.VarChar(255)
  note                   String?
  created_at             DateTime?            @default(now()) @db.Timestamp(6)
  shuttlecock_products   shuttlecock_products @relation(fields: [shuttlecock_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model shuttlecock_products {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                  @db.VarChar(255)
  brand                 String?                 @db.VarChar(100)
  balls_per_tube        Int                     @default(12)
  status                String                  @default("ACTIVE") @db.VarChar(20)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  shuttlecock_inventory shuttlecock_inventory?
  shuttlecock_movements shuttlecock_movements[]
}
